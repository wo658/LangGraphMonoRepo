{
  "extends": [
    "next/core-web-vitals",
    "prettier"
  ],
  "rules": {
    "no-unused-vars": ["warn", { 
      "args": "none",
      "varsIgnorePattern": "^_",
      "argsIgnorePattern": "^_"
    }],
    "prefer-const": "error",
    "no-console": "warn",
    "no-debugger": "error",
    "no-duplicate-imports": "warn",
    "no-unused-expressions": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "dist/",
    "build/",
    "components/ui/"
  ]
}